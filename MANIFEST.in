include README.md README.tr.md CHANGELOG.md LICENSE SECURITY.md CONTRIBUTING.md requirements-dev.lock
recursive-include docs *.md
recursive-include integrations *.py *.html *.txt
recursive-include samples *.py *.md
recursive-include tests *.py *.json
recursive-include .github/assets *.svg
global-exclude *.py[cod]
global-exclude __pycache__
recursive-include tools *.py
